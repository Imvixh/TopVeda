# ==============================================================================
# TopVeda Environment Variables Blueprint (Phase 6A: Cloudflare Stream)
# ==============================================================================
# Copy this file to `.env.local` for local development settings.
# Do NOT commit `.env.local` or any production secrets to version control.

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Public / Publishable Keys)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous / Publishable Key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional alias if your Supabase setup uses PUBLISHABLE_KEY:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ------------------------------------------------------------------------------
# 3. Phase 3.1: Admin Approval & Transactional Email Notification (Server-Only)
# ------------------------------------------------------------------------------
# Destination email address where new admin application alerts are sent
ADMIN_APPROVAL_OWNER_EMAIL=owner@example.com

# Resend API Key for transactional emails (e.g. re_xxxxxxxxx)
# Optional in development: when unset, EmailService logs simulated emails to console
RESEND_API_KEY=

# Verified sender email address
EMAIL_FROM="Vksarraf143@gmail.com"

# ------------------------------------------------------------------------------
# 4. Phase 6A: Cloudflare Stream Live Video & Recordings (Server-Only Secrets)
# ------------------------------------------------------------------------------
# Cloudflare Account ID (find in Cloudflare Dashboard URL or Overview page)
CLOUDFLARE_STREAM_ACCOUNT_ID=your-cloudflare-account-id

# Cloudflare API Token with "Account.Stream: Edit" permissions
# NEVER prefix with NEXT_PUBLIC_ and NEVER commit actual token values.
CLOUDFLARE_STREAM_API_TOKEN=your-cloudflare-stream-api-token

# Optional: Cloudflare Stream Customer Subdomain (e.g., customer-xyz.cloudflarestream.com)
# CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=

# ------------------------------------------------------------------------------
# 5. Phase 6A: Google YouTube OAuth 2.0 & Token Encryption (Server-Only Secrets)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Web Client ID
GOOGLE_YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google Cloud Console OAuth 2.0 Web Client Secret
# NEVER prefix with NEXT_PUBLIC_ and NEVER commit actual secrets.
GOOGLE_YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret

# Authorized redirect URI matching Google Cloud Console OAuth client configuration
# Development: http://localhost:3000/api/youtube/oauth/callback
# Production: https://topveda.in/api/youtube/oauth/callback
GOOGLE_YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback

# Optional: Dedicated 32-byte secret key for AES-256-GCM token encryption
# When unset, key is safely derived from client secret with SHA-256
# YOUTUBE_TOKEN_ENCRYPTION_KEY=
