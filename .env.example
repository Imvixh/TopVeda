# ==============================================================================
# TopVeda Environment Variables Blueprint (Phase 3: Supabase Auth)
# ==============================================================================
# Copy this file to `.env.local` for local development settings.
# Do NOT commit `.env.local` or any production secrets to version control.

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Public / Publishable Keys)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous / Publishable Key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional alias if your Supabase setup uses PUBLISHABLE_KEY:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
