# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage

# next.js build output
/.next/
/out/

# production & build output
/build
/dist/
/.vinext/
/.wrangler/

# misc
.DS_Store
*.pem
.system-state.json

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files (strictly ignore all real/local env files)
.env
.env*.local
.env.local
.env.development
.env.production
.env.staging
.env.*
!.env.example

# vercel
.vercel

# typescript build cache
*.tsbuildinfo
next-env.d.ts

# generated local audit reports, PDFs, and verification artifacts
*.pdf
TOPVEDA_FINAL_PRINCIPAL_SECURITY_AUDIT.*
SECURITY-AUDIT-REPORT.*
SECURITY_PRODUCTION_READINESS_REPORT.*
FINAL-PROJECT-DEPLOYMENT-RESULT.*

